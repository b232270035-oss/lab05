  "item": [
    {
      "name": "Амжилттай бүртгэл — бүх урьдач нөхцөл хангагдсан",
      "item": [
        {
          "name": "Setup: оюутан S_HAPPY",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/students/S_HAPPY",
            "body": {
              "mode": "raw",
              "raw": "{\"status\": \"active\", \"coursesTaken\": [\"CS201\", \"CS202\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Setup: хичээл C_HAPPY",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/courses/C_HAPPY",
            "body": {
              "mode": "raw",
              "raw": "{\"prerequisites\": [\"CS201\", \"CS202\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "POST /registrations",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/registrations",
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\": \"S_HAPPY\", \"courseID\": \"C_HAPPY\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('result is OK', function () { pm.expect(pm.response.json().result).to.eql('OK'); });",
                  "pm.test('registrationID is present and numeric', function () { pm.expect(pm.response.json().registrationID).to.be.a('number'); });"
                ]
              }
            }
          ]
        }
      ]
    },
